rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /companies/{companyId} {
      allow get: if companyMember(companyId, request.auth.uid);
      allow list: if false;
      allow create: if signedIn() && validCompany(companyId)
        && request.resource.data.ownerUid == request.auth.uid
        && getAfter(memberPath(companyId, request.auth.uid)).data.role == 'owner'
        && getAfter(memberPath(companyId, request.auth.uid)).data.status == 'active'
        && getAfter(indexPath(companyId, request.auth.uid)).data.role == 'owner'
        && getAfter(teamPath(companyId, 'general')).data.visibility == 'company';
      allow update, delete: if false;

      match /members/{uid} {
        allow get: if signedIn() && (uid == request.auth.uid || companyMember(companyId, request.auth.uid));
        allow list: if companyMember(companyId, request.auth.uid);
        allow create: if validCompanyMember(uid) && uid == request.auth.uid
          && indexMatchesAfter(companyId, uid)
          && (newCompanyOwner(companyId, uid) || joiningWithInvite(companyId, uid));
        allow update: if validCompanyMember(uid) && indexMatchesAfter(companyId, uid)
          && ((companyAdmin(companyId) && resource.data.role != 'owner'
            && request.resource.data.role != 'owner'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'status', 'updatedAt', 'updatedAtEpochMs']))
            || (uid == request.auth.uid && resource.data.status == 'removed' && joiningWithInvite(companyId, uid)));
        allow delete: if false;
      }
      match /teams/{teamId} {
        allow get: if companyMember(companyId, request.auth.uid) && !exists(teamPath(companyId, teamId));
        allow get, list: if companyMember(companyId, request.auth.uid)
          && (companyAdmin(companyId) || companyHost(companyId)
            || resource.data.visibility == 'company' || request.auth.uid in resource.data.memberIds);
        allow create: if validCompanyTeam(teamId)
          && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
          && (companyAdmin(companyId) || (teamId == 'general' && newCompanyOwner(companyId, request.auth.uid))
            || (companyMember(companyId, request.auth.uid) && request.resource.data.visibility == 'private'
              && request.resource.data.get('kind', '') in ['direct', 'group'] && request.auth.uid in request.resource.data.memberIds));
        allow update: if companyAdmin(companyId) && validCompanyTeam(teamId)
          && resource.data.get('kind', '') != 'direct' && request.resource.data.get('kind', '') == resource.data.get('kind', '')
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdAtEpochMs == resource.data.createdAtEpochMs;
        allow delete: if false;

        match /messages/{messageId} {
          allow read: if teamReader(companyId, teamId);
          allow create: if validCompanyMessage(messageId)
            && ((teamParticipant(companyId, teamId, request.auth.uid)
              && request.resource.data.authorUid == request.auth.uid
              && request.resource.data.authorName == get(memberPath(companyId, request.auth.uid)).data.displayName
              && request.resource.data.kind in ['human', 'personal_ai']
              && request.resource.data.requestId == '')
              || validCompanyAIMessage(companyId, teamId, messageId));
          allow update, delete: if false;
        }
        match /resources/{resourceId} {
          allow read: if teamReader(companyId, teamId);
          allow create: if teamParticipant(companyId, teamId, request.auth.uid)
            && validCompanyResource(resourceId) && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.authorName == get(memberPath(companyId, request.auth.uid)).data.displayName
            && request.resource.data.createdAt == request.time;
          allow update: if teamParticipant(companyId, teamId, request.auth.uid)
            && (resource.data.authorUid == request.auth.uid || companyAdmin(companyId))
            && validCompanyResource(resourceId)
            && request.resource.data.authorUid == resource.data.authorUid
            && request.resource.data.authorName == resource.data.authorName
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.createdAtEpochMs == resource.data.createdAtEpochMs;
          allow delete: if teamParticipant(companyId, teamId, request.auth.uid)
            && (resource.data.authorUid == request.auth.uid || companyAdmin(companyId));
        }
        match /tasks/{taskId} {
          allow read: if teamParticipant(companyId, teamId, request.auth.uid);
          allow create: if teamParticipant(companyId, teamId, request.auth.uid) && validCompanyTask(taskId)
            && request.resource.data.creatorUid == request.auth.uid
            && request.resource.data.creatorName == get(memberPath(companyId, request.auth.uid)).data.displayName
            && teamParticipant(companyId, teamId, request.resource.data.assigneeUid)
            && request.resource.data.assigneeName == get(memberPath(companyId, request.resource.data.assigneeUid)).data.displayName
            && request.resource.data.status == 'todo' && request.resource.data.resultText == ''
            && request.resource.data.createdAt == request.time && taskEventMatchesAfter(companyId, teamId, taskId);
          allow update: if teamParticipant(companyId, teamId, request.auth.uid) && validCompanyTask(taskId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resultText', 'lastEventId', 'updatedAt', 'updatedAtEpochMs'])
            && taskTransition(companyId) && taskEventMatchesAfter(companyId, teamId, taskId);
          allow delete: if false;
          match /events/{eventId} {
            allow read: if teamParticipant(companyId, teamId, request.auth.uid);
            allow create: if teamParticipant(companyId, teamId, request.auth.uid)
              && request.resource.data.keys().hasOnly(['id','authorUid','authorName','status','note','createdAt','createdAtEpochMs'])
              && request.resource.data.id == eventId && request.resource.data.authorUid == request.auth.uid
              && request.resource.data.authorName == get(memberPath(companyId, request.auth.uid)).data.displayName
              && textWithin(request.resource.data.note, 6000) && request.resource.data.createdAt == request.time
              && freshEpoch(request.resource.data.createdAtEpochMs)
              && getAfter(taskPath(companyId, teamId, taskId)).data.lastEventId == eventId
              && getAfter(taskPath(companyId, teamId, taskId)).data.status == request.resource.data.status
              && getAfter(taskPath(companyId, teamId, taskId)).data.updatedAt == request.time;
            allow update, delete: if false;
          }
        }
        match /files/{fileId} {
          allow read: if teamParticipant(companyId, teamId, request.auth.uid);
          allow create: if teamParticipant(companyId, teamId, request.auth.uid) && validCompanyFile(companyId, teamId, fileId)
            && request.resource.data.authorUid == request.auth.uid && request.resource.data.authorName == get(memberPath(companyId, request.auth.uid)).data.displayName
            && request.resource.data.status == 'uploading' && request.resource.data.createdAt == request.time;
          allow update: if teamParticipant(companyId, teamId, request.auth.uid) && resource.data.authorUid == request.auth.uid
            && validCompanyFile(companyId, teamId, fileId) && resource.data.status == 'uploading' && request.resource.data.status == 'ready'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','updatedAtEpochMs']);
          allow delete: if teamParticipant(companyId, teamId, request.auth.uid) && resource.data.authorUid == request.auth.uid && resource.data.status == 'uploading';
        }
      }
      match /settings/{settingId} {
        allow read: if settingId == 'host' && companyMember(companyId, request.auth.uid);
        allow create, update: if settingId == 'host' && validCompanyHost(companyId)
          && ((companyAdmin(companyId) && request.resource.data.heartbeatAt == null
            && request.resource.data.heartbeatAtEpochMs == 0)
            || (companyHost(companyId) && request.resource.data.uid == request.auth.uid
              && request.resource.data.heartbeatAt == request.time
              && freshEpoch(request.resource.data.heartbeatAtEpochMs)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['heartbeatAt', 'heartbeatAtEpochMs', 'updatedAt', 'updatedAtEpochMs'])));
        allow delete: if false;
      }
      match /aiRequests/{requestId} {
        allow read: if companyHost(companyId) || teamParticipant(companyId, resource.data.teamId, request.auth.uid);
        allow create: if validCompanyAIRequest(requestId)
          && get(teamPath(companyId, request.resource.data.teamId)).data.get('kind', '') != 'direct'
          && teamParticipant(companyId, request.resource.data.teamId, request.auth.uid)
          && request.resource.data.requesterUid == request.auth.uid
          && request.resource.data.requesterName == get(memberPath(companyId, request.auth.uid)).data.displayName
          && request.resource.data.status == 'queued'
          && request.resource.data.hostUid == '' && request.resource.data.hostDeviceId == ''
          && request.resource.data.claimId == '' && request.resource.data.leaseExpiresAtEpochMs == 0
          && request.resource.data.attempts == 0 && request.resource.data.outputText == ''
          && request.resource.data.errorMessage == '' && request.resource.data.createdAt == request.time
          && get(hostPath(companyId)).data.enabled == true
          && getAfter(/databases/$(database)/documents/companies/$(companyId)/aiRequestSlots/$(request.auth.uid)).data.requestId == requestId;
        allow update: if validCompanyAIRequest(requestId) && aiIdentityUnchanged()
          && (validAICancellation(companyId)
            || (companyHost(companyId) && teamParticipant(companyId, resource.data.teamId, resource.data.requesterUid)
            && request.resource.data.hostUid == request.auth.uid
            && request.resource.data.hostDeviceId == get(hostPath(companyId)).data.deviceId
            && (validAIClaim() || validAIRenewal() || validAICompletion(companyId, requestId))));
        allow delete: if false;
      }
      match /aiRequestSlots/{uid} {
        allow get: if isOwner(uid) && companyMember(companyId, uid);
        allow list: if false;
        allow create: if validAISlot(companyId, uid);
        allow update: if validAISlot(companyId, uid)
          && get(aiPath(companyId, resource.data.requestId)).data.status in ['completed', 'failed'];
        allow delete: if false;
      }
    }

    match /companyInvites/{inviteHash} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if inviteHash.matches('^[a-f0-9]{64}$') && validCompanyInvite()
        && companyAdmin(request.resource.data.companyId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.companyName == get(companyPath(request.resource.data.companyId)).data.name
        && request.resource.data.status == 'pending' && request.resource.data.usedBy == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAtEpochMs > request.time.toMillis()
        && request.resource.data.expiresAtEpochMs <= request.time.toMillis() + 604810000;
      allow update: if signedIn() && validCompanyInvite()
        && resource.data.status == 'pending' && resource.data.expiresAtEpochMs > request.time.toMillis()
        && request.resource.data.status == 'accepted' && request.resource.data.usedBy == request.auth.uid
        && (resource.data.email == '' || resource.data.email == request.auth.token.email.lower())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedBy', 'updatedAt'])
        && getAfter(memberPath(resource.data.companyId, request.auth.uid)).data.inviteHash == inviteHash
        && getAfter(memberPath(resource.data.companyId, request.auth.uid)).data.status == 'active'
        && getAfter(memberPath(resource.data.companyId, request.auth.uid)).data.role == resource.data.role
        && indexMatchesAfter(resource.data.companyId, request.auth.uid);
      allow delete: if companyAdmin(resource.data.companyId);
    }
    match /users/{uid}/companyMemberships/{companyId} {
      allow read: if isOwner(uid);
      allow create, update: if validCompanyIndex(companyId, uid)
        && (request.auth.uid == uid || companyAdmin(companyId))
        && request.resource.data.companyName == getAfter(companyPath(companyId)).data.name
        && request.resource.data.role == getAfter(memberPath(companyId, uid)).data.role
        && request.resource.data.status == getAfter(memberPath(companyId, uid)).data.status;
      allow delete: if false;
    }
    match /users/{userId}/private/{docId} {
      allow read: if isOwner(userId) && docId in ["aiCredential", "workspaceSync", "relayPreferences"];
      allow create, update: if isOwner(userId)
        && docId == "aiCredential"
        && isValidAiCredentialDocument();
      allow create, update: if isOwner(userId)
        && docId == "workspaceSync"
        && isValidWorkspaceSyncDocument();
      allow create, update: if isOwner(userId)
        && docId == "relayPreferences"
        && isValidRelayPreferencesDocument();
      allow delete: if isOwner(userId) && docId == "aiCredential";
    }

    match /users/{userId}/devices/{deviceId} {
      allow read, list: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidDeviceDocument();
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/relayRequests/{requestId} {
      allow read, list: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.status == "queued"
        && isValidRelayRequestDocument();
      allow update: if isOwner(userId) && isValidRelayRequestDocument();
      allow delete: if isOwner(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }

  function isOwner(userId) {
    return request.auth != null && request.auth.uid == userId;
  }

  function signedIn() { return request.auth != null; }
  function companyPath(cid) { return /databases/$(database)/documents/companies/$(cid); }
  function memberPath(cid, uid) { return /databases/$(database)/documents/companies/$(cid)/members/$(uid); }
  function indexPath(cid, uid) { return /databases/$(database)/documents/users/$(uid)/companyMemberships/$(cid); }
  function teamPath(cid, tid) { return /databases/$(database)/documents/companies/$(cid)/teams/$(tid); }
  function hostPath(cid) { return /databases/$(database)/documents/companies/$(cid)/settings/host; }
  function aiPath(cid, rid) { return /databases/$(database)/documents/companies/$(cid)/aiRequests/$(rid); }
  function companyMember(cid, uid) { return signedIn() && exists(memberPath(cid, uid)) && get(memberPath(cid, uid)).data.status == 'active'; }
  function companyAdmin(cid) { return companyMember(cid, request.auth.uid) && get(memberPath(cid, request.auth.uid)).data.role in ['owner', 'admin']; }
  function companyHost(cid) { return companyMember(cid, request.auth.uid) && exists(hostPath(cid)) && get(hostPath(cid)).data.enabled == true && get(hostPath(cid)).data.uid == request.auth.uid; }
  function teamParticipant(cid, tid, uid) { return companyMember(cid, uid) && exists(teamPath(cid, tid)) && (get(teamPath(cid, tid)).data.visibility == 'company' || uid in get(teamPath(cid, tid)).data.memberIds); }
  function teamReader(cid, tid) { return teamParticipant(cid, tid, request.auth.uid) || (companyHost(cid) && get(teamPath(cid, tid)).data.get('kind', '') != 'direct'); }
  function taskPath(cid, tid, taskId) { return /databases/$(database)/documents/companies/$(cid)/teams/$(tid)/tasks/$(taskId); }
  function taskEventMatchesAfter(cid, tid, taskId) {
    let event = getAfter(/databases/$(database)/documents/companies/$(cid)/teams/$(tid)/tasks/$(taskId)/events/$(request.resource.data.lastEventId)).data;
    return event.authorUid == request.auth.uid && event.status == request.resource.data.status && event.createdAt == request.time;
  }
  function validCompanyTask(taskId) {
    let d = request.resource.data;
    return d.keys().hasOnly(['id','title','description','assigneeUid','assigneeName','creatorUid','creatorName','dueDate','priority','status','resultText','lastEventId','createdAt','createdAtEpochMs','updatedAt','updatedAtEpochMs'])
      && d.id == taskId && nonempty(d.title,160) && textWithin(d.description,6000)
      && nonempty(d.assigneeUid,140) && nonempty(d.assigneeName,120) && nonempty(d.creatorUid,140) && nonempty(d.creatorName,120)
      && (d.dueDate == '' || d.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')) && d.priority in ['normal','high']
      && d.status in ['todo','doing','review','done','canceled'] && textWithin(d.resultText,6000) && nonempty(d.lastEventId,140)
      && (d.status != 'review' || d.resultText.size() > 0) && d.createdAt is timestamp && d.createdAtEpochMs is number
      && d.updatedAt == request.time && freshEpoch(d.updatedAtEpochMs);
  }
  function taskTransition(cid) {
    let before = resource.data.status; let after = request.resource.data.status;
    let assigner = resource.data.creatorUid == request.auth.uid || companyAdmin(cid);
    let assignee = resource.data.assigneeUid == request.auth.uid;
    return (assignee && before in ['todo','doing','review'] && after in ['doing','review'])
      || (assigner && ((before == 'review' && after == 'done') || (before in ['review','done','canceled'] && after == 'todo') || (before in ['todo','doing','review'] && after == 'canceled')));
  }
  function validCompanyFile(cid, tid, fid) {
    let d = request.resource.data;
    return d.keys().hasOnly(['id','name','size','sha256','storagePath','authorUid','authorName','status','createdAt','createdAtEpochMs','updatedAt','updatedAtEpochMs'])
      && d.id == fid && nonempty(d.name,180) && !d.name.matches('.*[/\\\\].*') && d.size is int && d.size > 0 && d.size <= 20971520
      && d.sha256.matches('^[a-f0-9]{64}$') && d.storagePath == 'companies/' + cid + '/teams/' + tid + '/files/' + d.authorUid + '/' + fid
      && nonempty(d.authorUid,140) && nonempty(d.authorName,120) && d.status in ['uploading','ready']
      && d.createdAt is timestamp && d.createdAtEpochMs is number && d.updatedAt == request.time && freshEpoch(d.updatedAtEpochMs);
  }
  function textWithin(value, maximum) { return value is string && value.size() <= maximum; }
  function nonempty(value, maximum) { return textWithin(value, maximum) && value.size() > 0; }
  function freshEpoch(value) { return value is number && value > request.time.toMillis() - 60000 && value < request.time.toMillis() + 60000; }
  function indexMatchesAfter(cid, uid) {
    let member = getAfter(memberPath(cid, uid)).data;
    let index = getAfter(indexPath(cid, uid)).data;
    return index.companyId == cid && index.uid == uid && index.role == member.role && index.status == member.status;
  }
  function newCompanyOwner(cid, uid) {
    return signedIn() && uid == request.auth.uid && !exists(companyPath(cid))
      && getAfter(companyPath(cid)).data.ownerUid == uid
      && getAfter(memberPath(cid, uid)).data.role == 'owner'
      && getAfter(memberPath(cid, uid)).data.status == 'active';
  }
  function joiningWithInvite(cid, uid) {
    let member = request.resource.data;
    let invitePath = /databases/$(database)/documents/companyInvites/$(member.inviteHash);
    let before = get(invitePath).data;
    let after = getAfter(invitePath).data;
    return signedIn() && uid == request.auth.uid && member.status == 'active'
      && member.role in ['admin', 'member'] && member.email == request.auth.token.email.lower()
      && before.companyId == cid && before.status == 'pending' && before.expiresAtEpochMs > request.time.toMillis()
      && companyMember(cid, before.createdBy) && get(memberPath(cid, before.createdBy)).data.role in ['owner', 'admin']
      && (before.email == '' || before.email == request.auth.token.email.lower())
      && before.role == member.role && after.status == 'accepted' && after.usedBy == uid;
  }
  function validCompany(cid) {
    let d = request.resource.data;
    return d.keys().hasOnly(['id', 'name', 'ownerUid', 'createdAtEpochMs', 'updatedAtEpochMs', 'createdAt', 'updatedAt'])
      && d.id == cid && nonempty(d.name, 120) && nonempty(d.ownerUid, 140)
      && freshEpoch(d.createdAtEpochMs) && freshEpoch(d.updatedAtEpochMs)
      && d.createdAt == request.time && d.updatedAt == request.time;
  }
  function validCompanyMember(uid) {
    let d = request.resource.data;
    return d.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'status', 'inviteHash', 'createdAtEpochMs', 'updatedAtEpochMs', 'createdAt', 'updatedAt'])
      && d.uid == uid && textWithin(d.email, 254) && nonempty(d.displayName, 120)
      && d.role in ['owner', 'admin', 'member'] && d.status in ['active', 'removed']
      && textWithin(d.inviteHash, 64) && d.createdAtEpochMs is number && freshEpoch(d.updatedAtEpochMs)
      && d.createdAt is timestamp && d.updatedAt == request.time;
  }
  function validCompanyIndex(cid, uid) {
    let d = request.resource.data;
    return signedIn() && d.keys().hasOnly(['uid', 'companyId', 'companyName', 'role', 'status', 'updatedAtEpochMs', 'updatedAt'])
      && d.uid == uid && d.companyId == cid && nonempty(d.companyName, 120)
      && d.role in ['owner', 'admin', 'member'] && d.status in ['active', 'removed']
      && freshEpoch(d.updatedAtEpochMs) && d.updatedAt == request.time;
  }
  function validCompanyInvite() {
    let d = request.resource.data;
    return d.keys().hasOnly(['companyId', 'companyName', 'email', 'role', 'status', 'usedBy', 'createdBy', 'createdAtEpochMs', 'expiresAtEpochMs', 'createdAt', 'updatedAt'])
      && nonempty(d.companyId, 140) && nonempty(d.companyName, 120) && textWithin(d.email, 254)
      && d.role in ['admin', 'member'] && d.status in ['pending', 'accepted'] && textWithin(d.usedBy, 140)
      && nonempty(d.createdBy, 140) && d.createdAtEpochMs is number && d.expiresAtEpochMs is number
      && d.createdAt is timestamp && d.updatedAt == request.time;
  }
  function validCompanyTeam(tid) {
    let d = request.resource.data;
    return d.keys().hasOnly(['id', 'name', 'visibility', 'memberIds', 'kind', 'createdBy', 'createdAtEpochMs', 'updatedAtEpochMs', 'createdAt', 'updatedAt'])
      && d.id == tid && nonempty(d.name, 80) && d.visibility in ['company', 'private']
      && (tid != 'general' || d.visibility == 'company')
      && d.memberIds is list && d.memberIds.size() <= 100 && d.memberIds.toSet().size() == d.memberIds.size()
      && d.get('kind', '') in ['', 'group', 'direct']
      && (d.get('kind', '') != 'direct' || (d.visibility == 'private' && d.memberIds.size() == 2 && request.auth.uid in d.memberIds))
      && nonempty(d.createdBy, 140) && d.createdAtEpochMs is number && freshEpoch(d.updatedAtEpochMs)
      && d.createdAt is timestamp && d.updatedAt == request.time;
  }
  function validCompanyMessage(mid) {
    let d = request.resource.data;
    return d.keys().hasOnly(['id', 'authorUid', 'authorName', 'kind', 'text', 'requestText', 'requestId', 'createdAtEpochMs', 'createdAt'])
      && d.id == mid && nonempty(d.authorUid, 140) && nonempty(d.authorName, 120)
      && d.kind in ['human', 'personal_ai', 'company_ai'] && nonempty(d.text, d.kind == 'human' ? 6000 : 16000)
      && textWithin(d.requestText, 6000) && textWithin(d.requestId, 140)
      && freshEpoch(d.createdAtEpochMs) && d.createdAt == request.time;
  }
  function validCompanyAIMessage(cid, tid, mid) {
    let d = request.resource.data;
    let before = get(aiPath(cid, d.requestId)).data;
    let after = getAfter(aiPath(cid, d.requestId)).data;
    return companyHost(cid) && d.kind == 'company_ai' && d.authorName == '회사 AI'
      && d.authorUid == request.auth.uid && mid == 'ai-' + d.requestId
      && before.status == 'running' && after.status == 'completed'
      && before.hostUid == request.auth.uid && before.teamId == tid
      && after.outputText == d.text && before.text == d.requestText
      && teamParticipant(cid, tid, before.requesterUid);
  }
  function validCompanyResource(rid) {
    let d = request.resource.data;
    return d.keys().hasOnly(['id', 'kind', 'title', 'text', 'authorUid', 'authorName', 'createdAtEpochMs', 'updatedAtEpochMs', 'createdAt', 'updatedAt'])
      && d.id == rid && d.kind in ['material', 'work_note'] && nonempty(d.title, 200) && nonempty(d.text, 20000)
      && nonempty(d.authorUid, 140) && nonempty(d.authorName, 120) && d.createdAtEpochMs is number
      && freshEpoch(d.updatedAtEpochMs) && d.createdAt is timestamp && d.updatedAt == request.time;
  }
  function validCompanyHost(cid) {
    let d = request.resource.data;
    return d.keys().hasOnly(['uid', 'deviceId', 'label', 'enabled', 'heartbeatAtEpochMs', 'heartbeatAt', 'updatedAtEpochMs', 'updatedAt'])
      && companyMember(cid, d.uid) && nonempty(d.uid, 140) && nonempty(d.deviceId, 140) && nonempty(d.label, 160)
      && d.enabled is bool && d.heartbeatAtEpochMs is number && freshEpoch(d.updatedAtEpochMs) && d.updatedAt == request.time;
  }
  function validCompanyAIRequest(rid) {
    let d = request.resource.data;
    return d.keys().hasOnly(['id', 'teamId', 'requesterUid', 'requesterName', 'text', 'status', 'hostUid', 'hostDeviceId', 'claimId', 'leaseExpiresAtEpochMs', 'attempts', 'outputText', 'errorMessage', 'createdAtEpochMs', 'updatedAtEpochMs', 'createdAt', 'updatedAt'])
      && d.id == rid && nonempty(d.teamId, 140) && nonempty(d.requesterUid, 140) && nonempty(d.requesterName, 120)
      && nonempty(d.text, 6000) && d.status in ['queued', 'running', 'completed', 'failed']
      && textWithin(d.hostUid, 140) && textWithin(d.hostDeviceId, 140) && textWithin(d.claimId, 140)
      && d.leaseExpiresAtEpochMs is number && d.attempts is int && d.attempts >= 0 && d.attempts <= 3
      && textWithin(d.outputText, 16000) && textWithin(d.errorMessage, 1000)
      && d.createdAtEpochMs is number && freshEpoch(d.updatedAtEpochMs)
      && d.createdAt is timestamp && d.updatedAt == request.time;
  }
  function aiIdentityUnchanged() {
    let d = request.resource.data;
    return d.id == resource.data.id && d.teamId == resource.data.teamId
      && d.requesterUid == resource.data.requesterUid && d.requesterName == resource.data.requesterName
      && d.text == resource.data.text && d.createdAt == resource.data.createdAt && d.createdAtEpochMs == resource.data.createdAtEpochMs;
  }
  function leaseInRange() { return request.resource.data.leaseExpiresAtEpochMs > request.time.toMillis() && request.resource.data.leaseExpiresAtEpochMs <= request.time.toMillis() + 185000; }
  function validAIClaim() {
    let d = request.resource.data;
    return d.status == 'running'
      && (resource.data.status == 'queued' || (resource.data.status == 'running' && resource.data.leaseExpiresAtEpochMs <= request.time.toMillis()))
      && leaseInRange() && nonempty(d.claimId, 140) && d.claimId != resource.data.claimId
      && d.attempts == resource.data.attempts + 1 && d.outputText == '' && d.errorMessage == '';
  }
  function sameLiveClaim() {
    let d = request.resource.data;
    return resource.data.status == 'running' && resource.data.leaseExpiresAtEpochMs > request.time.toMillis()
      && d.hostUid == resource.data.hostUid && d.hostDeviceId == resource.data.hostDeviceId
      && d.claimId == resource.data.claimId && d.attempts == resource.data.attempts;
  }
  function validAIRenewal() {
    return request.resource.data.status == 'running' && sameLiveClaim() && leaseInRange()
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leaseExpiresAtEpochMs', 'updatedAt', 'updatedAtEpochMs']);
  }
  function validAICompletion(cid, rid) {
    let d = request.resource.data;
    let message = /databases/$(database)/documents/companies/$(cid)/teams/$(d.teamId)/messages/$('ai-' + rid);
    return sameLiveClaim() && d.leaseExpiresAtEpochMs == resource.data.leaseExpiresAtEpochMs
      && ((d.status == 'failed' && d.errorMessage.size() > 0 && d.outputText == '')
        || (d.status == 'completed' && d.outputText.size() > 0 && d.errorMessage == ''
          && getAfter(message).data.kind == 'company_ai' && getAfter(message).data.requestId == rid
          && getAfter(message).data.text == d.outputText));
  }
  function validAICancellation(cid) {
    let d = request.resource.data;
    return signedIn() && resource.data.status in ['queued', 'running']
      && d.status == 'failed' && d.outputText == '' && d.errorMessage.size() > 0
      && d.diff(resource.data).affectedKeys().hasOnly(['status', 'outputText', 'errorMessage', 'updatedAt', 'updatedAtEpochMs'])
      && (request.auth.uid == resource.data.requesterUid || companyHost(cid) || companyAdmin(cid));
  }
  function validAISlot(cid, uid) {
    let d = request.resource.data;
    let next = getAfter(aiPath(cid, d.requestId)).data;
    return isOwner(uid) && companyMember(cid, uid)
      && d.keys().hasOnly(['requestId', 'updatedAtEpochMs', 'updatedAt'])
      && nonempty(d.requestId, 140) && freshEpoch(d.updatedAtEpochMs) && d.updatedAt == request.time
      && !exists(aiPath(cid, d.requestId)) && next.status == 'queued' && next.requesterUid == uid;
  }

  function isValidAiCredentialDocument() {
    return request.resource.data.keys().hasOnly([
        "provider",
        "model",
        "syncMode",
        "updatedAt",
        "updatedAtEpochMs",
        "createdAt"
      ])
      && request.resource.data.keys().hasAll([
        "provider",
        "model",
        "syncMode",
        "updatedAtEpochMs"
      ])
      && request.resource.data.provider in ["gemini", "openai", "claude"]
      && request.resource.data.model is string
      && request.resource.data.model.size() > 0
      && request.resource.data.model.size() <= 80
      && request.resource.data.syncMode == "metadata_only"
      && request.resource.data.updatedAtEpochMs is number;
  }

  function isValidDeviceDocument() {
    return request.resource.data.keys().hasOnly([
        "id",
        "label",
        "kind",
        "platform",
        "appVersion",
        "lastSeenAtEpochMs",
        "createdAtEpochMs",
        "capabilities",
        "updatedAt",
        "rawSecretMaterialStored"
      ])
      && request.resource.data.keys().hasAll([
        "id",
        "label",
        "kind",
        "platform",
        "lastSeenAtEpochMs",
        "createdAtEpochMs",
        "capabilities",
        "rawSecretMaterialStored"
      ])
      && request.resource.data.id is string
      && request.resource.data.id.size() > 6
      && request.resource.data.id.size() <= 120
      && request.resource.data.label is string
      && request.resource.data.label.size() > 0
      && request.resource.data.label.size() <= 160
      && request.resource.data.kind in ["desktop_app", "web_browser"]
      && request.resource.data.platform is string
      && request.resource.data.platform.size() <= 80
      && request.resource.data.lastSeenAtEpochMs is number
      && request.resource.data.createdAtEpochMs is number
      && request.resource.data.capabilities is list
      && request.resource.data.capabilities.size() <= 12
      && request.resource.data.rawSecretMaterialStored == false;
  }

  function isValidWorkspaceSyncDocument() {
    return request.resource.data.keys().hasOnly([
        "version",
        "sourceDeviceId",
        "sourceDeviceLabel",
        "sourceDeviceKind",
        "updatedAtEpochMs",
        "connectorSummaries",
        "triggerRules",
        "featureActivationRecords",
        "syncNote",
        "updatedAt",
        "rawSecretMaterialStored"
      ])
      && request.resource.data.keys().hasAll([
        "version",
        "sourceDeviceId",
        "sourceDeviceLabel",
        "sourceDeviceKind",
        "updatedAtEpochMs",
        "connectorSummaries",
        "triggerRules",
        "featureActivationRecords",
        "syncNote",
        "rawSecretMaterialStored"
      ])
      && request.resource.data.version == "modycrew.workspace-sync.v1"
      && request.resource.data.sourceDeviceId is string
      && request.resource.data.sourceDeviceId.size() > 6
      && request.resource.data.sourceDeviceId.size() <= 120
      && request.resource.data.sourceDeviceLabel is string
      && request.resource.data.sourceDeviceLabel.size() > 0
      && request.resource.data.sourceDeviceLabel.size() <= 160
      && request.resource.data.sourceDeviceKind in ["desktop_app", "web_browser"]
      && request.resource.data.updatedAtEpochMs is number
      && request.resource.data.connectorSummaries is list
      && request.resource.data.connectorSummaries.size() <= 40
      && request.resource.data.triggerRules is list
      && request.resource.data.triggerRules.size() <= 40
      && request.resource.data.featureActivationRecords is list
      && request.resource.data.featureActivationRecords.size() <= 12
      && request.resource.data.syncNote is string
      && request.resource.data.syncNote.size() <= 220
      && request.resource.data.rawSecretMaterialStored == false;
  }

  function isValidRelayRequestDocument() {
    return request.resource.data.keys().hasOnly([
        "id",
        "targetDeviceId",
        "targetDeviceLabel",
        "requesterDeviceId",
        "requesterDeviceLabel",
        "mode",
        "text",
        "status",
        "createdAtEpochMs",
        "updatedAtEpochMs",
        "resultSummary",
        "sessionId",
        "resultWorkItemIds",
        "resultDeepLink",
        "errorMessage",
        "updatedAt",
        "rawSecretMaterialStored"
      ])
      && request.resource.data.keys().hasAll([
        "id",
        "targetDeviceId",
        "targetDeviceLabel",
        "requesterDeviceId",
        "requesterDeviceLabel",
        "mode",
        "text",
        "status",
        "createdAtEpochMs",
        "updatedAtEpochMs",
        "rawSecretMaterialStored"
      ])
      && request.resource.data.id is string
      && request.resource.data.id.size() > 6
      && request.resource.data.id.size() <= 140
      && request.resource.data.targetDeviceId is string
      && request.resource.data.targetDeviceId.size() > 6
      && request.resource.data.targetDeviceId.size() <= 140
      && request.resource.data.targetDeviceLabel is string
      && request.resource.data.targetDeviceLabel.size() > 0
      && request.resource.data.targetDeviceLabel.size() <= 160
      && request.resource.data.requesterDeviceId is string
      && request.resource.data.requesterDeviceId.size() > 6
      && request.resource.data.requesterDeviceId.size() <= 140
      && request.resource.data.requesterDeviceLabel is string
      && request.resource.data.requesterDeviceLabel.size() > 0
      && request.resource.data.requesterDeviceLabel.size() <= 160
      && request.resource.data.mode in ["work_intake", "trigger_check", "connectivity_audit"]
      && request.resource.data.text is string
      && request.resource.data.text.size() > 0
      && request.resource.data.text.size() <= 1000
      && request.resource.data.status in ["queued", "running", "completed", "failed", "awaiting_approval", "needs_attention"]
      && request.resource.data.createdAtEpochMs is number
      && request.resource.data.updatedAtEpochMs is number
      && (!request.resource.data.keys().hasAny(["resultSummary"])
        || (request.resource.data.resultSummary is string
          && request.resource.data.resultSummary.size() <= 1000))
      && (!request.resource.data.keys().hasAny(["sessionId"])
        || (request.resource.data.sessionId is string
          && request.resource.data.sessionId.size() <= 140))
      && (!request.resource.data.keys().hasAny(["resultWorkItemIds"])
        || (request.resource.data.resultWorkItemIds is list
          && request.resource.data.resultWorkItemIds.size() <= 8))
      && (!request.resource.data.keys().hasAny(["resultDeepLink"])
        || (request.resource.data.resultDeepLink is string
          && request.resource.data.resultDeepLink.size() <= 260))
      && (!request.resource.data.keys().hasAny(["errorMessage"])
        || (request.resource.data.errorMessage is string
          && request.resource.data.errorMessage.size() <= 1000))
      && request.resource.data.rawSecretMaterialStored == false;
  }

  function isValidRelayPreferencesDocument() {
    return request.resource.data.keys().hasOnly([
        "version",
        "defaultDesktopDeviceId",
        "defaultDesktopDeviceLabel",
        "updatedByDeviceId",
        "updatedByDeviceLabel",
        "updatedAtEpochMs",
        "updatedAt",
        "rawSecretMaterialStored"
      ])
      && request.resource.data.keys().hasAll([
        "version",
        "defaultDesktopDeviceId",
        "defaultDesktopDeviceLabel",
        "updatedByDeviceId",
        "updatedByDeviceLabel",
        "updatedAtEpochMs",
        "rawSecretMaterialStored"
      ])
      && request.resource.data.version == "modycrew.relay-preferences.v1"
      && request.resource.data.defaultDesktopDeviceId is string
      && request.resource.data.defaultDesktopDeviceId.size() > 6
      && request.resource.data.defaultDesktopDeviceId.size() <= 140
      && request.resource.data.defaultDesktopDeviceLabel is string
      && request.resource.data.defaultDesktopDeviceLabel.size() > 0
      && request.resource.data.defaultDesktopDeviceLabel.size() <= 160
      && request.resource.data.updatedByDeviceId is string
      && request.resource.data.updatedByDeviceId.size() > 6
      && request.resource.data.updatedByDeviceId.size() <= 140
      && request.resource.data.updatedByDeviceLabel is string
      && request.resource.data.updatedByDeviceLabel.size() > 0
      && request.resource.data.updatedByDeviceLabel.size() <= 160
      && request.resource.data.updatedAtEpochMs is number
      && request.resource.data.rawSecretMaterialStored == false;
  }
  }
}
