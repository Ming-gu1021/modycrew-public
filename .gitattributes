# 모든 텍스트 파일은 LF 로 통일 (CRLF 경고 제거)
* text=auto eol=lf

# 명시적으로 LF 강제
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.json      text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Windows 전용 파일은 CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# 바이너리 (diff 생략)
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.pdf       binary
*.zip       binary
*.exe       binary
*.blockmap  binary
*.xlsx      binary
*.docx      binary
*.hwp       binary
*.ttf       binary
*.woff      binary
*.woff2     binary
